// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== USUÁRIOS ====================
model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  papel     String   @default("funcionario") // admin, funcionario, inspetor
  status    String   @default("ativo") // ativo, inativo
  avatar    String?
  criado    DateTime @default(now())
  atualizado DateTime @updatedAt

  // Relations
  defeitos       Defeito[]
  relatorios     Relatorio[]
  inspecoes      Inspecao[]

  @@map("usuarios")
}

// ==================== MODELOS ====================
model Modelo {
  codigo     String   @id @db.VarChar(120)
  descricao  String?
  criado     DateTime @default(now())
  atualizado DateTime @updatedAt

  // Relations
  placas Placa[]

  @@map("modelo")
}

// ==================== PLACAS ====================
model Placa {
  id          Int      @id @default(autoincrement())
  codigo      String?  @unique // Compatibilidade com telas/consultas legadas
  modeloCodigo String  @map("modelo") @db.VarChar(120)
  modelo      Modelo   @relation(fields: [modeloCodigo], references: [codigo], onDelete: Restrict)
  nomeClasse  String   @default("desconhecida") @map("nome_classe")
  descricao   String?
  localizacao String?
  criado      DateTime @default(now())
  atualizado  DateTime @updatedAt

  // Relations
  defeitos       Defeito[]
  defeitosVideo  DefeitoVideo[]
  inspecoes      Inspecao[]

  @@index([modeloCodigo])
  @@map("placas")
}

// ==================== DEFEITOS ====================
model Defeito {
  id          Int      @id @default(autoincrement())
  codigoInterno String  @unique @default(cuid()) // #DEF-XXXX
  idPlaca    Int      @map("id_placa")
  placa      Placa    @relation(fields: [idPlaca], references: [id], onDelete: Cascade)
  
  classeDefeito String @default("defeito-nao-classificado") @map("classe_defeito")
  dataHora    DateTime @default(now()) @map("data_hora")
  nomeArquivoOrigem String @default("desconhecido") @map("nome_arquivo_origem")
  tipo        String?  // Compatibilidade com filtros/telas antigas
  componente  String?  // descrição do componente afetado
  origem      String   @default("manual") // manual, automatico, importado
  severidade  String   @default("media") // baixa, media, alta, critica
  descricao   String?  @db.Text
  
  status      String   @default("aberto") // aberto, em-analise, resolvido, descartado
  usuarioId   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  
  criado      DateTime @default(now())
  atualizado  DateTime @updatedAt
  resolvido   DateTime?

  // Relations
  imagens     ImagemDefeito[]
  inspecoes   Inspecao[]
  relatorios  RelatorioDefeito[]
  videos      DefeitoVideo[]

  @@index([idPlaca])
  @@index([usuarioId])
  @@index([status])
  @@index([criado])
  @@map("defeitos")
}

// ==================== IMAGENS ====================
model ImagemDefeito {
  id        String   @id @default(cuid())
  defeitoId Int
  defeito   Defeito  @relation(fields: [defeitoId], references: [id], onDelete: Cascade)
  
  url       String
  tipo      String   @default("original") // original, processada, anotada
  metadados Json?    // contém dados EXIF, coordenadas, etc
  
  criado    DateTime @default(now())

  @@index([defeitoId])
  @@map("imagens_defeitos")
}

// ==================== DEFEITOS EM VÍDEO ====================
model DefeitoVideo {
  id          Int      @id @default(autoincrement())
  defeitoId   Int      @map("defeito_id")
  defeito     Defeito  @relation(fields: [defeitoId], references: [id], onDelete: Cascade)
  idPlaca     Int      @map("id_placa")
  placa       Placa    @relation(fields: [idPlaca], references: [id], onDelete: Cascade)

  classeDefeito String @default("defeito-nao-classificado") @map("classe_defeito")
  dataHora    DateTime @default(now()) @map("datahora")
  nomeArquivoOrigem String @default("desconhecido") @map("nome_arquivo_origem")
  frame       Int?
  tipo        String?
  componente  String?
  origem      String   @default("video")
  severidade  String   @default("media")
  descricao   String?  @db.Text
  status      String   @default("aberto")
  criado      DateTime @default(now())
  atualizado  DateTime @updatedAt

  @@index([defeitoId])
  @@index([idPlaca])
  @@index([dataHora])
  @@map("defeitos_video")
}

// ==================== INSPEÇÕES ====================
model Inspecao {
  id        String   @id @default(cuid())
  placaId   Int
  placa     Placa    @relation(fields: [placaId], references: [id], onDelete: Cascade)
  
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  
  tipo      String   @default("manual") // manual, automatizado, resumida
  descricao String?  @db.Text
  status    String   @default("em-progresso") // em-progresso, concluida, cancelada
  
  criado    DateTime @default(now())
  concluido DateTime?
  atualizado DateTime @updatedAt

  // Relations
  defeitos   Defeito[]

  @@index([placaId])
  @@index([usuarioId])
  @@index([criado])
  @@map("inspecoes")
}

// ==================== RELATÓRIOS ====================
model Relatorio {
  id        String   @id @default(cuid())
  codigoInterno String @unique @default(cuid()) // REL-XXX
  titulo    String
  descricao String? @db.Text
  
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  
  origem    String   @default("inspecao") // inspecao, analise-manual
  status    String   @default("rascunho") // rascunho, finalizado, arquivado
  
  criado    DateTime @default(now())
  atualizado DateTime @updatedAt

  // Relations
  defeitos  RelatorioDefeito[]

  @@index([usuarioId])
  @@index([criado])
  @@map("relatorios")
}

// ==================== RELAÇÃO MUITOS-PARA-MUITOS ====================
model RelatorioDefeito {
  id        String @id @default(cuid())
  relatorioId String
  relatorio Relatorio @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
  
  defeitoId Int
  defeito   Defeito   @relation(fields: [defeitoId], references: [id], onDelete: Cascade)
  
  notas     String? @db.Text
  criado    DateTime @default(now())

  @@unique([relatorioId, defeitoId])
  @@index([defeitoId])
  @@map("relatorios_defeitos")
}
